# Copy to .env (never commit .env). Only this file is tracked.
# Google AI Studio key; stays in the Electron main process, renderers only ever get ephemeral tokens.
GEMINI_API_KEY=

# --- optional flags (all default off; set to 1 to enable) ---
# Run every model-backed service on canned mock data (no key, no screen, no voice needed)
ALONGSIDE_MOCK=
# Mock one service: ALONGSIDE_MOCK_<NAME>=1 with NAME in CAPTURE OVERLAY GROUNDER VERIFIER ARCHITECT SCAM ROUTER LIVE LEARNER LEVELS RUNNER TEACHING AGENTS
# ALONGSIDE_MOCK_GROUNDER=1
# Mock only the ephemeral-token minting (Live and wake spotter get a "mock" token instead of calling Google)
# ALONGSIDE_MOCK_LIVE_AUTH=1
# Do not create the full-screen click-through overlay window
ALONGSIDE_NO_OVERLAY=
# Create windows hidden (no screen takeover)
ALONGSIDE_HEADLESS=
# Keep the overlay visible to screen recordings and screenshots (use when recording the demo video)
ALONGSIDE_OVERLAY_CAPTURABLE=
# Grounding model cascade: fast (flash-lite then flash, default) or accurate (flash only, slower)
# ALONGSIDE_GROUNDING_PRESET=fast
# Turn the dev HTTP control surface on (OFF by default everywhere: it has no auth). scripts/electron-lock.sh and the e2e runner set it; never set it for the demo.
# ALONGSIDE_DEBUG=1
# Dev HTTP control surface port (127.0.0.1 only; only used when ALONGSIDE_DEBUG=1)
ALONGSIDE_DEBUG_PORT=7777
# Isolated Electron profile directory (settings.json, profile.md); use an absolute path
ALONGSIDE_USERDATA=
# Port for `npm run stage` (the demo fake desktop)
STAGE_PORT=5180

# --- venue-Wi-Fi backup: record a good run once, replay it offline for the HTTP-based services (live voice still needs the network) ---
# Record every successful Google API JSON response of this run, keyed by request hash
# ALONGSIDE_RECORD=1
# Replay: 1 = serve recordings only (a miss behaves like a dead network); hybrid = serve hits, pass misses through
# ALONGSIDE_REPLAY=1
# Where recordings live (default <userData>/replay)
# ALONGSIDE_REPLAY_DIR=

# --- QA test hooks (inert unless ALONGSIDE_DEV_STAGE=1) ---
# Open the practice desktop in a window and start the QA dev HTTP (ground truth, overlay call log, Gemini request log, fault injection)
# ALONGSIDE_DEV_STAGE=1
# Port of the QA dev HTTP (127.0.0.1 only)
# ALONGSIDE_DEV_PORT=7778
# URL the QA hooks load as the stage window (default: the local practice desktop)
# ALONGSIDE_STAGE_URL=

# --- optional model overrides (read only in src/shared/models.ts) ---
# Voice + vision session
# MODEL_LIVE=gemini-3.8-live
# Grounding escalation, mid-tier verification, fast scam pass, lookup agent
# MODEL_FLASH=gemini-3.8-flash
# Grounding fast pass, first-tier verification, router
# MODEL_LITE=gemini-3.5-flash-lite
# Lesson architect, scam second opinion, last-tier verification (text-only, no Live API)
# MODEL_ARGON=gemini-4-argon
# Wake-name spotter
# MODEL_TRANSCRIBE=gemini-3.5-transcribe-live

# --- agency / showtime / dev flags (all optional) ---
# Hidden behind this flag until verified end to end: the act_for_me computer_use loop (1 = on)
# ALONGSIDE_AGENCY_LOOP=1
# Log desktop actions (click/type/keys/open) instead of performing them; tests always set this
# ALONGSIDE_ACTUATOR_DRYRUN=1
# Showtime scripted walkthrough: mode (scripted|live), full tour (1), mute narration (1), badge (0 hides it)
# ALONGSIDE_SHOWTIME_MODE=scripted
# ALONGSIDE_SHOWTIME_FULL=0
# ALONGSIDE_SHOWTIME_MUTE=0
# ALONGSIDE_SHOWTIME_BADGE=1
# URL the Showtime agency step opens (default https://www.ageuk.org.uk) and an override for its assets folder
# ALONGSIDE_SHOWTIME_OPEN_URL=
# ALONGSIDE_SHOWTIME_ASSETS=
# How long start_lesson waits for the Argon plan before using the built-in one (ms, default 8000)
# ALONGSIDE_PLAN_TIMEOUT_MS=8000
# Dev only: stage capture, mock overlay, shared Electron/npm lock tuning (see scripts/electron-lock.sh, npm-lock.sh)
# ALONGSIDE_DEV_CAPTURE=stage
# ALONGSIDE_MOCK_OVERLAY=0
# ALONGSIDE_USE_LOCK=1
# ALONGSIDE_LOCK_MAX_SECONDS=
# ALONGSIDE_LOCK_WAIT=
# ALONGSIDE_NPM_WAIT=
