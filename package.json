{
  "name": "alongside",
  "version": "0.1.0",
  "private": true,
  "description": "A voice-activated on-screen companion that teaches people to use computers, instead of doing it for them.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "stage": "node scripts/stage-server.mjs",
    "e2e": "node tests/e2e/run.mjs",
    "preflight": "node scripts/preflight.mjs",
    "demo": "bash scripts/demo.sh",
    "showtime": "bash scripts/start-demo.sh",
    "demo:interactive": "bash scripts/start-demo.sh --interactive",
    "submit-check": "node scripts/submit-check.mjs",
    "showtime:render": "node scripts/showtime-render.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@google/genai": "2.32.0",
    "dotenv": "18.0.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-vite": "6.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
